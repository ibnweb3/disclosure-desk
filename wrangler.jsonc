{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "disclosure-desk",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // static files are served by the platform; only /api/* runs Worker code
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  // stores the desk's own rToken-vs-equity snapshots (one small key per day); the id is provisioned on first deploy
  "kv_namespaces": [{ "binding": "SNAPS" }],
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    // Qwen family (hackathon sponsor). Small MoE keeps the demo inside Workers AI's free daily allocation.
    "LLM_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8"
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
